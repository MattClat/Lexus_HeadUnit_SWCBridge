<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="8dp">

    <!-- LEFT: configuration and tests -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingBottom="6dp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bridge enabled" />

            <Switch
                android:id="@+id/swKeepRunning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keep bridge running in background (v0.8 behaviour). OFF = lean mode: the app exits when idle so the unit can't force-stop it at switch-off" />

            <Switch
                android:id="@+id/swLeanExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="   lean mode: app ends its own process when idle (test switch - leave ON)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textStyle="bold"
                android:text="Input paths (leave both on until you see which fires)" />

            <Switch
                android:id="@+id/swInReceiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. MEDIA_BUTTON broadcast receiver" />

            <Switch
                android:id="@+id/swInSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Own MediaSession (priority grab) - only works when kept running" />

            <Switch
                android:id="@+id/swReassert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="   re-assert session priority every 15s" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textStyle="bold"
                android:text="Behaviour" />

            <Switch
                android:id="@+id/swActOnDown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Act on ACTION_DOWN (the fix)" />

            <Switch
                android:id="@+id/swSwap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Swap next / previous on the wheel (MCU has them reversed; USB remote is not swapped)" />

            <Switch
                android:id="@+id/swOnlyPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Only act while Poweramp is playing" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textStyle="bold"
                android:text="Play / pause gesture" />

            <Spinner
                android:id="@+id/spGesture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="Cost: the key carrying the gesture waits the window below before a single press does anything. The other key stays instant." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/sbWindow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="800" />

                <TextView
                    android:id="@+id/tvWindow"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textStyle="bold"
                android:text="Output mode" />

            <Spinner
                android:id="@+id/spOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textStyle="bold"
                android:text="Debounce (ms)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/sbDebounce"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1200" />

                <TextView
                    android:id="@+id/tvDebounce"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textStyle="bold"
                android:text="Android volume" />

            <Switch
                android:id="@+id/swVolumeBoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Force Android volume at startup" />

            <Switch
                android:id="@+id/swVolumeNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Top up Android volume on every NEXT press" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/sbVolume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvVolume"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="end" />
            </LinearLayout>

            <Switch
                android:id="@+id/swVolumeUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show volume dialog (needed to pass the safe limit)" />

            <Spinner
                android:id="@+id/spVolumeMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnVolumeNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apply volume now" />

            <Button
                android:id="@+id/btnVolumeDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volume snapshot (all streams)" />

            <Button
                android:id="@+id/btnSafeVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Disable safe-volume limit (needs adb grant)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="Snapshot, press volume on the USB REMOTE, snapshot again. Whichever number moved is the stream Android really uses. Do not use the steering wheel - its volume never reaches Android." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textStyle="bold"
                android:text="Test the OUTPUT path (no wheel needed)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPrev"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="&lt;&lt; PREV" />

                <Button
                    android:id="@+id/btnPlayPause"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PLAY/PAUSE" />

                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NEXT &gt;&gt;" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textStyle="bold"
                android:text="Test the INPUT path" />

            <Button
                android:id="@+id/btnSimulate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simulate head unit bug (MEDIA_NEXT, DOWN only)" />

            <Button
                android:id="@+id/btnSimulateGood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simulate a normal press (DOWN + UP)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textSize="11sp"
                android:text="Desk test: turn BOTH input paths OFF, then tap 'Simulate head unit bug' - Poweramp will not skip (that is the fault). Tap 'Simulate a normal press' - it will. Now turn the input paths back on and the bug simulation should skip too." />

        </LinearLayout>
    </ScrollView>

    <!-- RIGHT: live event log -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingLeft="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                android:text="Event log" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:typeface="monospace"
                android:textSize="10sp"
                android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
